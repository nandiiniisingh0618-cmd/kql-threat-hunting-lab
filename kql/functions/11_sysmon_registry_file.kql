// Sysmon EventID 17/18 - Named pipe created / connected.
.create-or-alter function with (folder = "10-normalize/sysmon", docstring = "Sysmon 17/18: named pipe create and connect")
SysmonPipe() {
    LabEvents()
    | where tostring(raw.Channel) =~ "Microsoft-Windows-Sysmon/Operational"
        and toint(raw.EventID) in (17, 18)
    | project
        TimeGenerated      = NormalizeTime(raw),
        Computer           = tostring(raw.Hostname),
        Account            = tostring(raw.User),
        ProcessName        = tostring(raw.Image),
        Process            = tostring(split(tostring(raw.Image), "\\")[-1]),
        PipeName           = tostring(raw.PipeName),
        PipeEventType      = tostring(raw.EventType),
        ProcessId          = tostring(raw.ProcessId),
        EventID            = toint(raw.EventID),
        DatasetId          = dataset_id,
        SourceFile         = source_file
}

//---

// Sysmon EventID 19/20/21 - WMI filter, consumer and filter-to-consumer binding.
// This is the telemetry for WMI event-subscription persistence.
.create-or-alter function with (folder = "10-normalize/sysmon", docstring = "Sysmon 19/20/21: WMI eventing objects")
SysmonWmiEvent() {
    LabEvents()
    | where tostring(raw.Channel) =~ "Microsoft-Windows-Sysmon/Operational"
        and toint(raw.EventID) in (19, 20, 21)
    | project
        TimeGenerated      = NormalizeTime(raw),
        Computer           = tostring(raw.Hostname),
        Account            = coalesce(tostring(raw.User), tostring(raw.AccountName)),
        WmiOperation       = tostring(raw.Operation),
        WmiName            = tostring(raw.Name),
        WmiQuery           = tostring(raw.Query),
        WmiEventNamespace  = tostring(raw.EventNamespace),
        WmiConsumer        = tostring(raw.Consumer),
        WmiFilter          = tostring(raw.Filter),
        WmiDestination     = tostring(raw.Destination),
        WmiType            = tostring(raw.Type),
        EventID            = toint(raw.EventID),
        Activity           = case(toint(raw.EventID) == 19, "WmiFilter",
                                  toint(raw.EventID) == 20, "WmiConsumer",
                                  toint(raw.EventID) == 21, "WmiBinding",
                                  "Other"),
        DatasetId          = dataset_id,
        SourceFile         = source_file
}
