// Sysmon EventID 12 (key create/delete), 13 (value set), 14 (key/value rename).
// Registry is the backbone of several persistence and defence-impairment detections.
.create-or-alter function with (folder = "10-normalize/sysmon", docstring = "Sysmon 12/13/14: registry activity")
SysmonRegistry() {
    LabEvents()
    | where tostring(raw.Channel) =~ "Microsoft-Windows-Sysmon/Operational"
        and toint(raw.EventID) in (12, 13, 14)
    | project
        TimeGenerated      = NormalizeTime(raw),
        Computer           = tostring(raw.Hostname),
        Account            = tostring(raw.User),
        RegistryEventType  = tostring(raw.EventType),
        RegistryKey        = tostring(raw.TargetObject),
        RegistryValueData  = tostring(raw.Details),
        ProcessName        = tostring(raw.Image),
        Process            = tostring(split(tostring(raw.Image), "\\")[-1]),
        ProcessId          = tostring(raw.ProcessId),
        ProcessGuid        = tostring(raw.ProcessGuid),
        EventID            = toint(raw.EventID),
        DatasetId          = dataset_id,
        SourceFile         = source_file
}

//---

// Sysmon EventID 11 (file create) and 23 (file delete / archive).
.create-or-alter function with (folder = "10-normalize/sysmon", docstring = "Sysmon 11/23: file create and delete")
SysmonFileEvent() {
    LabEvents()
    | where tostring(raw.Channel) =~ "Microsoft-Windows-Sysmon/Operational"
        and toint(raw.EventID) in (11, 23)
    | project
        TimeGenerated      = NormalizeTime(raw),
        Computer           = tostring(raw.Hostname),
        Account            = tostring(raw.User),
        ProcessName        = tostring(raw.Image),
        Process            = tostring(split(tostring(raw.Image), "\\")[-1]),
        TargetFilename     = tostring(raw.TargetFilename),
        IsExecutable       = tostring(raw.IsExecutable),
        Hashes             = tostring(raw.Hashes),
        ProcessId          = tostring(raw.ProcessId),
        EventID            = toint(raw.EventID),
        Activity           = case(toint(raw.EventID) == 11, "FileCreate",
                                  toint(raw.EventID) == 23, "FileDelete",
                                  "Other"),
        DatasetId          = dataset_id,
        SourceFile         = source_file
}

//---

// Sysmon EventID 7 - Image (DLL) load, with Authenticode signature state.
.create-or-alter function with (folder = "10-normalize/sysmon", docstring = "Sysmon 7: module load with signature state")
SysmonImageLoad() {
    LabEvents()
    | where tostring(raw.Channel) =~ "Microsoft-Windows-Sysmon/Operational"
        and toint(raw.EventID) == 7
    | project
        TimeGenerated      = NormalizeTime(raw),
        Computer           = tostring(raw.Hostname),
        Account            = tostring(raw.User),
        ProcessName        = tostring(raw.Image),
        Process            = tostring(split(tostring(raw.Image), "\\")[-1]),
        ImageLoaded        = tostring(raw.ImageLoaded),
        ModuleName         = tostring(split(tostring(raw.ImageLoaded), "\\")[-1]),
        Signed             = tostring(raw.Signed),
        Signature          = tostring(raw.Signature),
        SignatureStatus    = tostring(raw.SignatureStatus),
        Hashes             = tostring(raw.Hashes),
        ProcessId          = tostring(raw.ProcessId),
        EventID            = toint(raw.EventID),
        DatasetId          = dataset_id,
        SourceFile         = source_file
}

