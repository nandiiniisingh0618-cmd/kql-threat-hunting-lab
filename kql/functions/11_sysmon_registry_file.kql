// Sysmon EventID 3 - Network connection, attributed to the initiating process.
.create-or-alter function with (folder = "10-normalize/sysmon", docstring = "Sysmon 3: process-attributed network connections")
SysmonNetwork() {
    LabEvents()
    | where tostring(raw.Channel) =~ "Microsoft-Windows-Sysmon/Operational"
        and toint(raw.EventID) == 3
    | project
        TimeGenerated      = NormalizeTime(raw),
        Computer           = tostring(raw.Hostname),
        Account            = tostring(raw.User),
        ProcessName        = tostring(raw.Image),
        Process            = tostring(split(tostring(raw.Image), "\\")[-1]),
        SourceIp           = tostring(raw.SourceIp),
        SourcePort         = toint(raw.SourcePort),
        DestinationIp      = tostring(raw.DestinationIp),
        DestinationPort    = toint(raw.DestinationPort),
        DestinationHostname = tostring(raw.DestinationHostname),
        Protocol           = tostring(raw.Protocol),
        Initiated          = tostring(raw.Initiated),
        ProcessId          = tostring(raw.ProcessId),
        EventID            = toint(raw.EventID),
        DatasetId          = dataset_id,
        SourceFile         = source_file
}

