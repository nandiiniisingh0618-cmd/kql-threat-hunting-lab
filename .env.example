# Copy to .env (gitignored) and edit. Never commit .env.
#
# ---------------------------------------------------------------------------
# TARGET 1 (default): local Kusto emulator via Docker.
# No authentication, no HTTPS -> it MUST stay bound to localhost.
# ---------------------------------------------------------------------------
KUSTO_URI=http://127.0.0.1:8080
KUSTO_DB=KqlLab
KUSTO_AUTH_MODE=none

# Host port to publish the emulator on (always bound to 127.0.0.1).
KUSTAINER_PORT=8080
# Memory for the emulator container. 4g is the practical minimum.
KUSTAINER_MEMORY=4g

# ---------------------------------------------------------------------------
# TARGET 2: Azure Data Explorer free cluster.
# Create it in the ADX web UI first (see docs/setup-free-cluster.md), then:
#   KUSTO_URI=https://<your-cluster>.<region>.kusto.windows.net
#   KUSTO_DB=KqlLab
#   KUSTO_AUTH_MODE=device      # interactive device-code sign-in
# ---------------------------------------------------------------------------

# Optional: include the Git-LFS-backed splunk/attack_data source.
# Requires git-lfs installed. Enables the 6 "experimental" detections.
INCLUDE_ATTACK_DATA=0
